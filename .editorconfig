# .editorconfig
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Makefile requires real tabs
[Makefile]
indent_style = tab

# Shell scripts: 2-space indent (project convention)
[*.sh]
indent_size = 2

# Python follows PEP 8 (4 spaces) — override to 2 for project consistency
[*.py]
indent_size = 2

# YAML, JSON, Markdown: 2 spaces
[*.{yml,yaml,json,md}]
indent_size = 2

# Editor-specific settings (ignored by tools that don't understand them)
[*.{sh,py,yml,yaml,json,md,mdx}]
# VS Code: disable auto-indent for heredoc bodies to avoid false positives
# (handled manually)
[*.sh]
# vim: set tabstop=2 shiftwidth=2 expandtab: