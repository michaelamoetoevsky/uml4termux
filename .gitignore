# .gitignore
# Every large binary asset is fetched by the CLI at runtime and never committed.
# See CONTRIBUTING.md for the asset policy.

# Logs & evidence
*.log
evidence/*.raw.log

# Disk images & initramfs
*.ext4
*.cpio
*.cpio.gz

# Downloaded kernels (SUBARCH=arm64 downstream port)
bin/linux*

# Downloaded userspace network stack
gvproxy

# Python
__pycache__/
*.pyc

# Build outputs
build/
dist/

# UML runtime directory
.uml/

# Temporary working directories
tmp/

# OS/editor noise
.DS_Store
*.swp
*.swo
*~

# CI kernel artifacts: never track the binaries; releases carry them
ci-kernel-artifact*/

# curated evidence logs (C5) — must come after any *.log rule
!evidence/logs/
!evidence/logs/*.log

# Rust build outputs
rust/target/
bench/out/
soak/out/
