#!/bin/sh
#
# uml4termux — guest init (PID 1 inside the initramfs).
#
# Generated by scripts/build-initramfs.py from scripts/guest/init; @@TOKENS@@
# are substituted at build time.
#
# Flow (the verified runbook):
#   1. mount /proc /sys /dev (devtmpfs) in the initramfs
#   2. mount /dev/ubda (the Debian 12 + Docker ext4 image) at /newroot
#   3. copy the guest scripts into the image
#   4. mount --move /proc /sys /dev into /newroot
#   5. exec switch_root /newroot <entry script>
#
# Gate mode boots without a disk image: then the entry script runs right here.
#
# NOTE: /bin/sh (busybox ash) on purpose — the initramfs has no bash.  The
# script uses no bashisms and only `set -u` (busybox ash cannot be relied on
# for `set -o pipefail`).  NEVER use `exit` here: use `poweroff -f`.
#
# SPDX-License-Identifier: GPL-2.0-only

set -u
PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

GUEST_ENTRY="@@GUEST_ENTRY@@"
GUEST_MODE="@@GUEST_MODE@@"
GUEST_LIFETIME="@@GUEST_LIFETIME@@"

GUEST_FILES="init docker-init.sh forensic.sh"
STASH=/newroot/.uml4termux

say() { printf 'UML4TERMUX_INIT %s\n' "$*"; }

poweroff_hard() {
  sync 2>/dev/null || true
  if command -v poweroff >/dev/null 2>&1; then poweroff -f; fi
  if [ -x /sbin/poweroff ]; then /sbin/poweroff -f; fi
  # last resort: keep the kernel from spinning forever
  echo "UML4TERMUX_INIT poweroff_unavailable"
  while true; do sleep 3600; done
}

say "version=@@UML4TERMUX_VERSION@@ mode=${GUEST_MODE} entry=${GUEST_ENTRY}"

mount -t proc proc /proc 2>/dev/null || say "warn: proc mount failed"
mount -t sysfs sysfs /sys 2>/dev/null || say "warn: sysfs mount failed"
mount -t devtmpfs devtmpfs /dev 2>/dev/null || say "warn: devtmpfs mount failed"
mkdir -p /newroot
say "mounts_ok"

# ---------------------------------------------------------------------------
# no disk image (gate mode / offline boot): stay in the initramfs
# ---------------------------------------------------------------------------
if [ ! -b /dev/ubda ] && [ ! -e /dev/ubda ]; then
  say "NO_DISK: no /dev/ubda, running ${GUEST_ENTRY} inside the initramfs"
  if [ -x "${GUEST_ENTRY}" ]; then
    "${GUEST_ENTRY}"
    rc=$?
  else
    say "entry_missing ${GUEST_ENTRY}"
    rc=1
  fi
  say "entry_finished rc=${rc}"
  poweroff_hard
fi

# ---------------------------------------------------------------------------
# mount the disk image
# ---------------------------------------------------------------------------
if ! mount -t ext4 -o rw /dev/ubda /newroot; then
  say "ROOT_MOUNT_FAILED"
  poweroff_hard
fi
say "root_mounted /dev/ubda -> /newroot"

# ---------------------------------------------------------------------------
# copy the guest scripts into the image (entry script at the image root, the
# full set stashed under /.uml4termux so nothing of the image is overwritten)
# ---------------------------------------------------------------------------
mkdir -p "${STASH}"
for f in ${GUEST_FILES}; do
  if [ -f "/${f}" ]; then
    cp "/${f}" "${STASH}/${f}" || say "warn: cannot stash ${f}"
    chmod 0755 "${STASH}/${f}" 2>/dev/null || true
  fi
done
if [ -f "${GUEST_ENTRY}" ]; then
  target="/newroot${GUEST_ENTRY}"
  cp "${GUEST_ENTRY}" "${target}" || { say "COPY_SCRIPT_FAILED ${GUEST_ENTRY}"; poweroff_hard; }
  chmod 0755 "${target}" 2>/dev/null || true
  say "copied ${GUEST_ENTRY} -> ${target}"
else
  say "COPY_SCRIPT_FAILED: ${GUEST_ENTRY} missing in the initramfs"
  poweroff_hard
fi

# ---------------------------------------------------------------------------
# hand the mounts over and switch root
# ---------------------------------------------------------------------------
mount --move /proc /newroot/proc 2>/dev/null || say "warn: move proc failed"
mount --move /sys  /newroot/sys  2>/dev/null || say "warn: move sys failed"
mount --move /dev  /newroot/dev  2>/dev/null || say "warn: move dev failed"
mkdir -p /newroot/run /newroot/tmp

say "SWITCH_ROOT_NOW ${GUEST_ENTRY}"
exec switch_root /newroot "${GUEST_ENTRY}"
say "SWITCH_ROOT_FAILED"
poweroff_hard
